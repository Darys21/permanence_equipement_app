# Template .env pour skill sharepoint-graph-schema
# Copier dans .env A LA RACINE PROJET. Ne JAMAIS versionner le fichier rempli de valeurs réelles.

# Tenant Microsoft Entra ID = organisation
SHAREPOINT_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# App Registration ID client Entra
SHAREPOINT_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Secret ONLY mode client_credentials (batch serveur sans inter)
SHAREPOINT_CLIENT_SECRET=<leave blank for device code flow>

# Mode authentification: device | client_credentials
AUTH_MODE=device

# URL du site SharePoint cible PERMANANCE EQUIPEMENT
SITE_URL=https://erametgroup.sharepoint.com/sites/PERMANANCEEQUIPEMENT

# Listes a extraire (6 du projet). Laisser defaut.
TARGET_LISTS=Ref_Cantons,Ref_Acteurs,Tx_Travaux,Tx_Feedbacks,Tx_incidents_Ruptures,Tx_LTV

# Formats sortie
OUTPUT_FORMAT=json,yaml

# Dossier destination schemas extraits
OUTPUT_DIR=Backend/schemas_export/
